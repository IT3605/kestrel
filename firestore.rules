rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Entity Blueprint: UserAccount
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'accountLabel',
          'rememberTrustedDevice',
          'requireStepUpForBilling',
          'preferredAuthMethod',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'accountLabel',
          'rememberTrustedDevice',
          'requireStepUpForBilling',
          'preferredAuthMethod',
          'createdAt',
          'updatedAt',
          'chosenGroupName',
          'shareGroupStatus',
          'optedOutOfGroup',
          'hideTierProgress',
          'weeklyReminderOptIn',
          'trialReminder24h',
          'reducedMotionCelebration'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.accountLabel is string
        && data.accountLabel.size() >= 1
        && data.accountLabel.size() <= 60
        && data.rememberTrustedDevice is bool
        && data.requireStepUpForBilling is bool
        && data.preferredAuthMethod == 'google'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('chosenGroupName' in data) || (data.chosenGroupName is string && data.chosenGroupName.size() >= 1 && data.chosenGroupName.size() <= 40))
        && (!('shareGroupStatus' in data) || data.shareGroupStatus is bool)
        && (!('optedOutOfGroup' in data) || data.optedOutOfGroup is bool)
        && (!('hideTierProgress' in data) || data.hideTierProgress is bool)
        && (!('weeklyReminderOptIn' in data) || data.weeklyReminderOptIn is bool)
        && (!('trialReminder24h' in data) || data.trialReminder24h is bool)
        && (!('reducedMotionCelebration' in data) || data.reducedMotionCelebration is bool);
    }

    // Entity Blueprint: SignInEvent
    function isValidSignInEvent(data, userId) {
      return data.keys().hasAll([
          'uid',
          'provider',
          'deviceSummary',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'provider',
          'deviceSummary',
          'status',
          'createdAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.provider == 'google.com'
        && data.deviceSummary is string
        && data.deviceSummary.size() >= 1
        && data.deviceSummary.size() <= 120
        && (data.status == 'active' || data.status == 'ended')
        && data.createdAt is timestamp;
    }

    // Private User Account Profile & Preferences
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'accountLabel',
          'rememberTrustedDevice',
          'requireStepUpForBilling',
          'chosenGroupName',
          'shareGroupStatus',
          'optedOutOfGroup',
          'hideTierProgress',
          'weeklyReminderOptIn',
          'trialReminder24h',
          'reducedMotionCelebration',
          'updatedAt'
        ]);

      allow delete: if false;

      // Subcollection: Sign-In Events (Master Gate enforces parent /users/{userId} exists)
      match /signInEvents/{eventId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(eventId)
          && isOwner(userId)
          && parentUserExists(userId);

        allow list: if isVerifiedUser()
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(eventId)
          && isOwner(userId)
          && isValidSignInEvent(incoming(), userId)
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(eventId)
          && isOwner(userId)
          && isValidSignInEvent(incoming(), userId)
          && existing().status != 'ended'
          && incoming().status == 'ended'
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          && parentUserExists(userId);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(eventId)
          && isOwner(userId)
          && parentUserExists(userId);
      }
    }
  }
}
